+bool Framebuffer::write_png(const char *path) const
+{
+    if (path == nullptr || *path == '\0' || m_width <= 0 || m_height <= 0) return false;
+    std::vector<unsigned char> rgb(m_pixel.size() * 3u);
+    write_rgb_range(rgb.data(), 0, m_pixel.size());
+    png_image image{};
+    image.version = PNG_IMAGE_VERSION;
+    image.width = static_cast<png_uint_32>(m_width);
+    image.height = static_cast<png_uint_32>(m_height);
+    image.format = PNG_FORMAT_RGB;
+    return png_image_write_to_file(&image, path, 0, rgb.data(), 0, nullptr) != 0;
+}
