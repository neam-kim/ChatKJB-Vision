+    bool write_ai3d_state(const Camera &camera, const char *path)
+    {
+        if (path == nullptr || *path == '\0') return false;
+        const std::string tmp = std::string(path) + ".tmp";
+        std::ofstream out(tmp, std::ios::trunc);
+        if (!out) return false;
+        const vec3 offset = camera.eye() - camera.target;
+        const float azimuth = std::atan2(offset.z, offset.x) * 180.0f / 3.14159265358979323846f;
+        const float elevation = std::atan2(offset.y, std::sqrt(offset.x * offset.x + offset.z * offset.z))
+            * 180.0f / 3.14159265358979323846f;
+        out << "{\"camera\":{\"quaternion\":[" << camera.orientation.x << "," << camera.orientation.y << ","
+            << camera.orientation.z << "," << camera.orientation.w << "],\"azimuth\":" << azimuth
+            << ",\"elevation\":" << elevation << ",\"distance\":" << camera.distance << ",\"target\":["
+            << camera.target.x << "," << camera.target.y << "," << camera.target.z << "]}}\n";
+        out.close();
+        if (!out) return false;
+        std::error_code ec;
+        std::filesystem::rename(tmp, path, ec);
+        return !ec;
+    }

